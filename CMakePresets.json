{
      "version": 8,
      "configurePresets": [
            {
                  "name": "base-mingw",
                  "hidden": true,
                  "displayName": "Base MinGW Configuration",
                  "description": "Using compilers: C = C:\\msys64\\ucrt64\\bin\\gcc.exe, CXX = C:\\msys64\\ucrt64\\bin\\g++.exe",
                  "generator": "MinGW Makefiles",
                  "binaryDir": "${sourceDir}/out/build/${presetName}",
                  "cacheVariables": {
                        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
                  }
            },
            {
                  "name": "mingw-debug",
                  "inherits": "base-mingw",
                  "displayName": "GCC 14.2.0 MinGW (Debug)",
                  "cacheVariables": {
                        "CMAKE_BUILD_TYPE": "Debug"
                  }
            },
            {
                  "name": "mingw-release",
                  "inherits": "base-mingw",
                  "displayName": "GCC 14.2.0 MinGW (Release)",
                  "cacheVariables": {
                        "CMAKE_BUILD_TYPE": "Release"
                  }
            }
      ],
      "buildPresets": [
            {
                  "name": "build-debug",
                  "configurePreset": "mingw-debug",
                  "displayName": "Build Debug"
            },
            {
                  "name": "build-release",
                  "configurePreset": "mingw-release",
                  "displayName": "Build Release"
            }
      ]
}